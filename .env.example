# ============================================================
# Environment Variables for Docker Compose
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env
# ============================================================

# --- MySQL ---
DB_NAME=placement_db
DB_USERNAME=placement
DB_PASSWORD=placementpass
# Port exposed on the host for MySQL (default 3306)
MYSQL_PORT=3306

# --- Backend (Spring Boot) ---
# IMPORTANT: In production, set a strong random secret (>= 32 bytes).
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
# Token expiration in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000
# Hibernate DDL mode: update (dev) / validate (prod)
DDL_AUTO=update
# Show SQL in logs
SHOW_SQL=false

# --- Mail (optional SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
APP_FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# Base URL for the backend API used at build time by the React app.
# If the frontend calls the backend directly (via nginx proxy), keep this.
VITE_API_BASE_URL=http://localhost:8080

# --- Twilio SMS Service (Optional - defaults to mock provider if unconfigured) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# --- Firebase & Google Sign-In (Frontend) ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# --- Firebase Token Verification (Backend - Optional project ID enforcement) ---
FIREBASE_PROJECT_ID=your-project-id
# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy to a SECURE location (never commit to GitHub).
#   cp .env.production.example .env.production
# ============================================================

# ---------- Spring Profile ----------
# Set to 'prod' for production profile (application-prod.properties)
SPRING_PROFILES_ACTIVE=prod

# ---------- Application ----------
SERVER_PORT=8080
SWAGGER_ENABLED=false

# ---------- Database (Production MySQL / Aiven) ----------
# Either provide individual host/port/credentials or direct DB_URL:
DB_HOST=mysql-8ad9146-nilaybhamareclg-356c.b.aivencloud.com
DB_PORT=18805
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Optional full JDBC URL override (supported by application.properties and application-prod.properties):
# DB_URL=jdbc:mysql://mysql-8ad9146-nilaybhamareclg-356c.b.aivencloud.com:18805/defaultdb?sslMode=REQUIRED
# Hibernate DDL: 'update' (safely adds missing tables/columns without dropping data)
DDL_AUTO=update
DB_POOL_MAX=20
DB_POOL_MIN=5

# ---------- JWT (CRITICAL SECRET) ----------
# Generate a strong secret (>= 48 random chars):
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_48_CHAR_SECRET
JWT_EXPIRATION_MS=86400000

# ---------- Mail / SMTP (Optional - defaults to graceful simulation if unset) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password

# ---------- Frontend URL (for OAuth callbacks & password reset links) ----------
APP_FRONTEND_URL=https://campus-job-amber.vercel.app

# ---------- CORS (comma-separated allowed origins) ----------
CORS_ALLOWED_ORIGINS=https://campus-job-amber.vercel.app,http://localhost:3000,http://localhost:5173

# ---------- Firebase Token Verification (Backend - Optional project ID match) ----------
FIREBASE_PROJECT_ID=campus-job-2564d

# ============================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ============================================================
# Public API URL of the deployed Render backend
VITE_API_BASE_URL=https://campus-job-veqq.onrender.com

# Firebase Authentication configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=campus-job-2564d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campus-job-2564d
VITE_FIREBASE_STORAGE_BUCKET=campus-job-2564d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

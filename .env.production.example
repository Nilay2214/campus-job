# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy to a SECURE location (never commit to GitHub).
#   cp .env.production.example .env.production
# ============================================================

# ---------- Spring Profile ----------
# Never blank; always 'prod' in production
SPRING_PROFILES_ACTIVE=prod

# ---------- Application ----------
SERVER_PORT=8080
# Set to false to hide Swagger UI in production
SWAGGER_ENABLED=false

# ---------- Database (Production MySQL) ----------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=placement_db
DB_USERNAME=placement_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Hibernate DDL: 'validate' (recommended) or 'none' once migrations are live
DDL_AUTO=validate
DB_POOL_MAX=20
DB_POOL_MIN=5

# ---------- JWT (CRITICAL SECRET) ----------
# Generate a strong secret (>= 48 random chars):
#   openssl rand -base64 48
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_48_CHAR_SECRET
# Token lifetime in milliseconds (24h default)
JWT_EXPIRATION_MS=86400000

# ---------- Mail / SMTP ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password

# ---------- Frontend Build ----------
# In production behind HTTPS, use the real public API origin:
#   - Same-domain via nginx proxy: /api handled by nginx -> set to '' or same-origin
#   - Separate domain: https://api.yourdomain.com
VITE_API_BASE_URL=https://yourdomain.com

# ---------- CORS (comma-separated allowed origins) ----------
# Update SecurityConfig allowed origins to match your production frontend origin.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================================================
# Campus Job — Git Ignore Rules
# ============================================================

# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example
!.env.production.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Node / Frontend Build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/
.eslintcache

# Java / Maven / Backend Build
target/
backend/target/
bin/
backend/bin/
*.class
DbHelper.class

# Uploads & Local File Storage
uploads/
backend/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep

# Logs & Debug Output
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Metadata
.idea/
backend/.idea/
frontend/.idea/
.vscode/
backend/.vscode/
frontend/.vscode/
*.iml
.classpath
.project
.settings/
backend/.settings/
.metadata/
.mylyn/
.plugins/
.lock
.lock_info
version.ini

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary Test / Scratch artifacts
scratch/
query
